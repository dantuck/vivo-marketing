---
const steps = [
  {
    title: 'Initialize vivo',
    desc: 'A guided setup: checks prerequisites, creates your age key, sets the restic password, adds and tests an off-site remote, then offers a dry-run and a first backup. Steps 2–4 below are the same pieces, available on their own. Not on a terminal? It writes a static starter config instead.',
    cmd: ['vivo init'],
  },
  {
    title: 'Add a backup task',
    desc: 'Create a named task with its restic repo and the directory to back up. Or use vivo manage for an interactive TUI.',
    cmd: ['vivo task add --name main --repo ~/.local/share/restic/main --dir ~', 'vivo manage'],
  },
  {
    title: 'Add remote destinations',
    desc: 'Attach one or more remotes to a task — S3, RustFS, or Backblaze B2. Run vivo remote add with no flags for a guided flow, then test every remote any time.',
    cmd: ['vivo secrets import-s3 --profile rustfs', 'vivo remote add --task main --url "rustfs:http://nas:9000/bucket" --credentials rustfs', 'vivo remote test', 'vivo remote list'],
  },
  {
    title: 'Add your secrets',
    desc: 'Set your restic password and any additional remote credentials, encrypted with SOPS + age.',
    cmd: ['vivo secrets edit'],
  },
  {
    title: 'Run a backup',
    desc: 'Dry-run first to verify your setup, then run the real backup.',
    cmd: ['vivo --dry-run', 'vivo'],
    note: 'vivo exits non-zero if the backup fails or any remote fails to sync, so schedulers can alert on it.',
  },
]
---

<section class="quickstart" id="quick-start">
  <div class="inner">
    <p class="label">Quick Start</p>
    <h2>Up and running<br />in five steps.</h2>

    <div class="steps">
      {steps.map((s, i) => (
        <div class="step">
          <div class="num" aria-hidden="true">{i + 1}</div>
          <div class="content">
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
            <pre class="cmd" set:html={s.cmd.map(line => `<span class="prompt">$</span> ${line}`).join('\n')}></pre>
            {s.note && <p class="note">{s.note}</p>}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .quickstart {
    background: var(--bg2);
    padding: 80px 48px;
    transition: background 0.2s;
  }

  .inner {
    max-width: 700px;
    margin: 0 auto;
  }

  .label {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 12px;
  }

  h2 {
    font-size: clamp(28px, 4vw, 38px);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--text);
    margin-bottom: 40px;
  }

  .steps {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .step {
    display: flex;
    gap: 20px;
    align-items: flex-start;
    min-width: 0;
  }

  .num {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--accent);
    color: #0f172a;
    font-weight: 700;
    font-size: 13px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .content {
    min-width: 0;
    flex: 1;
  }

  .content h3 {
    font-size: 16px;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 4px;
  }

  .content p {
    font-size: 14px;
    color: var(--muted);
    margin-bottom: 10px;
  }

  .cmd {
    background: var(--code-bg);
    border: 1px solid var(--border);
    border-radius: 7px;
    padding: 10px 14px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 13px;
    color: var(--code-text);
    margin: 0;
    white-space: pre;
    overflow-x: auto;
    line-height: 1.7;
  }

  .prompt { color: var(--accent); }

  .content p.note { margin: 10px 0 0; font-size: 13px; }

  @media (max-width: 640px) {
    .quickstart { padding: 56px 16px; }
    .cmd { font-size: 12px; }
  }
</style>
