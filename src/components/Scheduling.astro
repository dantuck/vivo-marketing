---
const options = [
  {
    title: 'macOS (launchd)',
    file: '~/Library/LaunchAgents/dev.vivo.backup.plist',
    code: `<key>ProgramArguments</key>
<array><string>/usr/local/bin/vivo</string></array>
<key>EnvironmentVariables</key>
<dict><key>PATH</key>
  <string>/opt/homebrew/bin:/usr/bin:/bin</string>
  <!-- config, secrets, age key, state dir -->
</dict>
<key>StartCalendarInterval</key>
<dict><key>Hour</key><integer>2</integer>
  <key>Minute</key><integer>0</integer></dict>`,
  },
  {
    title: 'Linux (systemd timer)',
    file: '~/.config/systemd/user/vivo.{service,timer}',
    code: `# vivo.service
[Service]
Type=oneshot
Environment="PATH=..."
ExecStart=/home/you/.local/bin/vivo

# vivo.timer
[Timer]
OnCalendar=*-*-* 02:00:00
Persistent=true`,
  },
  {
    title: 'cron',
    file: 'your crontab (no systemd)',
    code: `# >>> vivo backup >>>
0 2 * * * PATH='...' '/usr/local/bin/vivo' \\
  >> '~/.local/state/vivo/vivo.log' 2>&1
# <<< vivo backup <<<`,
  },
]
---

<section class="scheduling" id="scheduling">
  <div class="inner">
    <p class="label">Scheduling</p>
    <h2>One command.<br />Backed up every day.</h2>
    <p class="intro">
      <code>vivo schedule add</code> installs the right scheduler for your system and takes care of the
      details that make hand-written jobs fail: the full path to <code>vivo</code>, a <code>PATH</code> that
      finds <code>restic</code>, <code>sops</code> and your sync tools, your custom config and key locations,
      and a log file. A Mac that is asleep at backup time runs it on wake. vivo exits non-zero on any failure,
      and <code>vivo status</code> tells you whether the last run actually worked.
    </p>

    <pre class="code main"><span class="prompt">$</span> vivo schedule add             <span class="cmt"># daily at 02:00, or --at 03:30</span>
<span class="prompt">$</span> vivo schedule status          <span class="cmt"># is it installed, and when does it run?</span>
<span class="prompt">$</span> vivo status                   <span class="cmt"># latest snapshot and last sync per remote</span>
<span class="prompt">$</span> vivo schedule remove</pre>

    <p class="sub">What vivo installs for you:</p>

    <div class="grid">
      {options.map((o) => (
        <div class="card">
          <h3>{o.title}</h3>
          <span class="file">{o.file}</span>
          <pre class="code">{o.code}</pre>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .scheduling {
    background: var(--bg2);
    padding: 80px 48px;
    transition: background 0.2s;
  }

  .inner {
    max-width: 960px;
    margin: 0 auto;
  }

  .label {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 12px;
  }

  h2 {
    font-size: clamp(28px, 4vw, 38px);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--text);
    margin-bottom: 20px;
  }

  .intro {
    font-size: 15px;
    color: var(--muted);
    line-height: 1.7;
    max-width: 700px;
    margin-bottom: 36px;
  }

  .intro code {
    background: var(--bg3);
    border-radius: 4px;
    padding: 1px 6px;
    font-family: ui-monospace, monospace;
    font-size: 13px;
    color: var(--accent);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .card {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 24px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: background 0.2s;
  }

  .card h3 {
    font-size: 15px;
    font-weight: 600;
    color: var(--text);
  }

  .file {
    font-family: ui-monospace, monospace;
    font-size: 12px;
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  .code {
    background: var(--code-bg);
    border: 1px solid var(--border);
    border-radius: 7px;
    padding: 10px 12px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 12px;
    color: var(--code-text);
    margin: 0;
    white-space: pre;
    overflow-x: auto;
    line-height: 1.7;
  }

  .prompt { color: var(--accent); }
  .cmt { color: var(--muted); }

  .code.main {
    margin-bottom: 28px;
    font-size: 13px;
  }

  .sub {
    font-size: 13px;
    font-weight: 600;
    color: var(--muted);
    margin-bottom: 14px;
  }

  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 640px) {
    .scheduling { padding: 56px 16px; }
    .code { font-size: 11px; }
  }
</style>
